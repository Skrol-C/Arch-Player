<?xml version="1.0" encoding="utf-8"?>
<!-- R8 resource shrinking cannot see drawables referenced by runtime
     string lookup. audio_service resolves every control icon via
     getIdentifier() ("drawable/audio_service_*"), and our notification
     icon plus the shuffle/repeat state icons the same way - all
     invisible to static analysis. Without this file, release builds
     strip them, every notification post throws "You must specify an
     icon resource id", and playback runs with no foreground protection
     (background death follows).
     Debug builds keep everything, which is why this only ever
     breaks in release. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_stat_music_note,@drawable/ic_notif_*" />
